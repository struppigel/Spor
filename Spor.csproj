<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Spor</AssemblyName>
    <RootNamespace>Spor</RootNamespace>
    <Version>0.12.0</Version>
    <!-- Version info shown in Explorer > Properties > Details. AssemblyTitle is the "File description". -->
    <Product>Spor</Product>
    <AssemblyTitle>Spor - forensic triage for malware removal helpers</AssemblyTitle>
    <Description>Collects execution, download, persistence and remote-access evidence into one log file, Spor.txt. Reads only, changes nothing on the system. https://github.com/struppigel/Spor</Description>
    <Company>Karsten Hahn</Company>
    <Authors>Karsten Hahn</Authors>
    <Copyright>Copyright (c) 2026 Karsten Hahn</Copyright>
    <!-- 64-bit on 64-bit Windows: no registry or System32 redirection -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>resources\Spor.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <!-- The tests are a project of their own (tests/Spor.Tests), not part of Spor.exe -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- The tests build their own copy of Spor (SporTests=true, set by tests/Spor.Tests) with internals
       visible, in bin\tests and obj\tests. The released Spor.exe has no reference to the tests. -->
  <PropertyGroup Condition="'$(SporTests)' == 'true'">
    <OutputPath>bin\tests\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\tests\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(SporTests)' == 'true'">
    <InternalsVisibleTo Include="Spor.Tests" />
  </ItemGroup>

  <!-- Autodetect: known-malware patterns (src/Autodetect.cs), embedded encrypted (src/PatternCrypt.cs): no plain malware
       paths and command lines in Spor.exe for antivirus engines and strings dumps. resources/autodetect.txt stays the source. -->
  <PropertyGroup>
    <PatternSource>$(MSBuildProjectDirectory)\resources\autodetect.txt</PatternSource>
    <PatternKeySource>$(MSBuildProjectDirectory)\src\PatternCrypt.cs</PatternKeySource>
  </PropertyGroup>

  <!-- The same format as PatternCrypt.Encrypt (a test decrypts the embedded file and compares it with the source) -->
  <UsingTask TaskName="EncryptPatterns" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Input ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
      <KeySource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var m = Regex.Match(File.ReadAllText(KeySource), "KeyHex = \"([0-9a-fA-F]{64})\"");
        if (!m.Success)
        {
            Log.LogError("EncryptPatterns: no KeyHex = \"<64 hex digits>\" in " + KeySource);
        }
        else
        {
            var hex = m.Groups[1].Value;
            var key = Enumerable.Range(0, 32).Select(i => Convert.ToByte(hex.Substring(2 * i, 2), 16)).ToArray();
            var plain = File.ReadAllBytes(Input);
            byte[] iv, macKey, ct;
            using (var sha = SHA256.Create())
            {
                iv = sha.ComputeHash(plain).Take(16).ToArray();
                macKey = sha.ComputeHash(key.Concat(Encoding.ASCII.GetBytes("mac")).ToArray());
            }
            using (var aes = Aes.Create())
            {
                aes.Mode = CipherMode.CBC; aes.Padding = PaddingMode.PKCS7; aes.Key = key; aes.IV = iv;
                using (var e = aes.CreateEncryptor()) ct = e.TransformFinalBlock(plain, 0, plain.Length);
            }
            var body = iv.Concat(ct).ToArray();
            byte[] mac;
            using (var h = new HMACSHA256(macKey)) mac = h.ComputeHash(body);
            Directory.CreateDirectory(Path.GetDirectoryName(Output));
            File.WriteAllBytes(Output, body.Concat(mac).ToArray());
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- IntermediateOutputPath is only set after this file's properties are read: the output path and the resource item are made
       when the targets run (PatternOutputPath first, so EncryptPatterns' Inputs/Outputs can use it) -->
  <Target Name="PatternOutputPath" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <PatternOutput>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)autodetect.bin</PatternOutput>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(PatternOutput)" LogicalName="Spor.autodetect.bin" />
    </ItemGroup>
  </Target>

  <Target Name="EncryptPatterns" AfterTargets="PatternOutputPath" BeforeTargets="PrepareForBuild"
          Inputs="$(PatternSource);$(PatternKeySource)" Outputs="$(PatternOutput)">
    <EncryptPatterns Input="$(PatternSource)" Output="$(PatternOutput)" KeySource="$(PatternKeySource)" />
  </Target>

  <!-- Well-known publishers (Rules.TrustedSigners) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/publishers.txt" LogicalName="Spor.publishers.txt" />
  </ItemGroup>

  <!-- Vulnerable signed drivers (Rules.VulnerableDrivers) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/vulndrivers.txt" LogicalName="Spor.vulndrivers.txt" />
  </ItemGroup>

  <!-- Large program icon for the About window (src/AboutForm.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/Spor.png" LogicalName="Spor.Spor.png" />
  </ItemGroup>

  <!-- Known-noise rules (src/Whitelist.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/whitelist.txt" LogicalName="Spor.whitelist.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
    <!-- JavaScriptSerializer: browser Preferences (extensions) -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- Building on Linux/macOS: use Mono's .NET Framework 4.8 reference assemblies instead of the NuGet package -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

</Project>
