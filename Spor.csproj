<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Spor</AssemblyName>
    <RootNamespace>Spor</RootNamespace>
    <Version>0.8.0</Version>
    <!-- Version info shown in Explorer > Properties > Details. AssemblyTitle is the "File description". -->
    <Product>Spor</Product>
    <AssemblyTitle>Spor - forensic triage for malware removal helpers</AssemblyTitle>
    <Description>Collects execution, download, persistence and remote-access evidence into one log file, Spor.txt. Reads only, changes nothing on the system. https://github.com/struppigel/Spor</Description>
    <Company>Karsten Hahn</Company>
    <Authors>Karsten Hahn</Authors>
    <Copyright>Copyright (c) 2026 Karsten Hahn</Copyright>
    <!-- 64-bit on 64-bit Windows: no registry or System32 redirection -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>resources\Spor.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <!-- The tests are a project of their own (tests/Spor.Tests), not part of Spor.exe -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- The tests build their own copy of Spor (SporTests=true, set by tests/Spor.Tests) with internals
       visible, in bin\tests and obj\tests. The released Spor.exe has no reference to the tests. -->
  <PropertyGroup Condition="'$(SporTests)' == 'true'">
    <OutputPath>bin\tests\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\tests\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(SporTests)' == 'true'">
    <InternalsVisibleTo Include="Spor.Tests" />
  </ItemGroup>

  <!-- Autodetect: known-malware patterns (src/Autodetect.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/autodetect.txt" LogicalName="Spor.autodetect.txt" />
  </ItemGroup>

  <!-- Well-known publishers (Rules.TrustedSigners) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/publishers.txt" LogicalName="Spor.publishers.txt" />
  </ItemGroup>

  <!-- Large program icon for the About window (src/AboutForm.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/Spor.png" LogicalName="Spor.Spor.png" />
  </ItemGroup>

  <!-- Known-noise rules (src/Whitelist.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="resources/whitelist.txt" LogicalName="Spor.whitelist.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- Building on Linux/macOS: use Mono's .NET Framework 4.8 reference assemblies instead of the NuGet package -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

</Project>
